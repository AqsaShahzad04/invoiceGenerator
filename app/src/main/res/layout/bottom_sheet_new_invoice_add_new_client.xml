<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="28dp">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/drag_handle_bg" />

    <!-- Title row: text + close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick add client"
                android:textSize="17sp"
                android:fontFamily="@font/inter_bold"
                android:textColor="#171817" />

            <TextView
                android:layout_width="286dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sae to your clients and selected for this invoice"
                android:textSize="12sp"
                android:textColor="#5C625E" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/closeBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_cross_button"
            android:src="@drawable/ic_close"
            android:scaleType="center"
            android:contentDescription="Close" />

    </LinearLayout>

    <!-- Client name label + input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Business Name"
        android:fontFamily="@font/inter_medium"
        android:textSize="11sp"
        android:textColor="#5C625E"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/businessNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:hint="e.g. AL-Barka Store"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:textSize="14sp"
        android:textColor="#171817"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contact Person"
        android:fontFamily="@font/inter_medium"
        android:textSize="11sp"
        android:textColor="#5C625E"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/clientNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:hint="e.g. Yusuf Muhammad"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:textSize="14sp"
        android:textColor="#171817"
        android:layout_marginBottom="12dp" />

    <!-- Phone label + input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone · optional"
        android:textSize="11sp"
        android:fontFamily="@font/inter_medium"
        android:textColor="#5C625E"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/clientPhoneInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="+92 300 1234567"
        android:inputType="phone"
        android:fontFamily="@font/inter_medium"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:textSize="14sp"
        android:textColor="#171817"
        android:layout_marginBottom="16dp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Address"
        android:textSize="11sp"
        android:fontFamily="@font/inter_medium"
        android:textColor="#5C625E"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/clientAddressInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Street, area, city"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:gravity="top|start"
        android:fontFamily="@font/inter_medium"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:textSize="14sp"
        android:textColor="#171817"
        android:layout_marginBottom="16dp" />

    <!-- Add client button -->
    <Button
        android:id="@+id/addClientBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add &amp; select"
        android:paddingHorizontal="14dp"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/bg_cream"
        app:backgroundTint="@null"
        android:background="@drawable/green_btn_bg"
        android:backgroundTint="@color/btn_bg_dark"
        />
    <ProgressBar
        android:id="@+id/editclientProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</LinearLayout>