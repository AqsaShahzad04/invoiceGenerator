<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:padding="14dp">

    <TextView
        android:id="@+id/workspaceAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/avatar_circle"
        android:backgroundTint="#0C861A"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:text="MB"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:letterSpacing="-0.02"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/workspaceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/inter_semibold"
        android:text="My Business"
        android:textColor="#171817"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@+id/statusContainer"
        app:layout_constraintStart_toEndOf="@id/workspaceAvatar"
        app:layout_constraintTop_toTopOf="@id/workspaceAvatar" />

    <TextView
        android:id="@+id/workspaceSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text=""
        android:textColor="#5C625E"
        android:textSize="11sp"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="@id/workspaceName"
        app:layout_constraintStart_toStartOf="@id/workspaceName"
        app:layout_constraintTop_toBottomOf="@id/workspaceName" />

    <TextView
        android:id="@+id/workspaceNTN"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text="NTN "
        android:textColor="#9CA3A0"
        android:textSize="10sp"
        android:layout_marginTop="1dp"
        app:layout_constraintEnd_toEndOf="@id/workspaceName"
        app:layout_constraintStart_toStartOf="@id/workspaceName"
        app:layout_constraintTop_toBottomOf="@id/workspaceSubtitle" />

    <LinearLayout
        android:id="@+id/statusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/activeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="● Active"
            android:textAllCaps="true"
            android:textColor="#0C861A"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/inter_medium"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:text="Edit"
            android:textColor="#5C625E"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>