<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:paddingTop="20dp"
    android:paddingHorizontal="28dp"
    android:paddingBottom="28dp">


    <View
        android:id="@+id/backbtnview"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_login_back_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
       />
    <ImageView
        android:id="@+id/backbtn"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/ic_login_screen"
        android:clickable="true"
        app:layout_constraintStart_toStartOf="@+id/backbtnview"
        app:layout_constraintTop_toTopOf="@+id/backbtnview"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="@+id/backbtnview"
        app:layout_constraintBottom_toBottomOf="@+id/backbtnview"
        />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/inter_bold"
        android:letterSpacing="-0.02"
        android:textColor="#171817"
        android:text="Welcome back"
        android:textSize="26sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/backbtnview" />

    <TextView
        android:id="@+id/subheading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Sign in to continue billing "
        android:textSize="13sp"
        android:fontFamily="@font/inter"
        android:layout_marginBottom="28sp"
        android:textColor="#5C625E"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5"
        />

    <TextView
        android:id="@+id/emailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:text="Email"
        android:textColor="#5C625E"
        android:textSize="11sp"
        tools:layout_editor_absoluteX="46dp"
        tools:layout_editor_absoluteY="194dp"
        android:layout_marginTop="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subheading"/>

    <EditText
        android:id="@+id/editTextTextEmailAddress"
        android:layout_width="match_parent"
        android:layout_marginTop="6dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_field"
        android:ems="10"
        android:fontFamily="@font/inter"
        android:hint="you@business.pk"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:textColor="#171817"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="197dp"
        app:layout_constraintTop_toBottomOf="@+id/emailLabel"
        />

    <TextView
        android:id="@+id/passLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/inter_medium"
        android:text="password"
        android:textColor="#5C625E"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextTextEmailAddress" />

    <EditText
        android:id="@+id/editTextTextPassword"
        android:inputType="textPassword"
        android:layout_width="match_parent"
        android:layout_marginTop="6dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_field"
        android:ems="10"
        android:fontFamily="@font/inter"
        android:hint="••••••••"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:textColor="#171817"
        android:textSize="13sp"
        tools:layout_editor_absoluteX="38dp"
        tools:layout_editor_absoluteY="293dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passLabel"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/forgotPass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:fontFamily="@font/inter_medium"
        android:text="Forgot Password?"
        android:textColor="#0C861A"
        android:textSize="12sp"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextTextPassword"
        tools:layout_editor_absoluteX="278dp"
        tools:layout_editor_absoluteY="353dp" />

    <Button
        android:id="@+id/button2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:background="@drawable/sign_in_button_bg"
        android:fontFamily="@font/inter_semibold"
        android:paddingHorizontal="14dp"
        android:text="Sign in"
        android:textColor="#FBFAF7"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/forgotPass"
        android:gravity="center"/>

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New here? "
        android:textColor="#5C625E"
        android:textSize="13sp"
        android:fontFamily="@font/inter"
        android:paddingTop="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/createone"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <TextView
        android:id="@+id/createone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:text="Create one"
        android:textColor="#0C861A"
        android:textSize="13sp"
        android:fontFamily="@font/inter"
        android:paddingTop="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/textView6"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/loginProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>