<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_select_items_new_invoice"
    android:padding="12dp"
    android:layout_marginBottom="6dp">
    <TextView
        android:id="@+id/itemName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GPUS"
        android:textSize="13sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/btn_bg_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
    <TextView
        android:id="@+id/itemDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AED 0.piece"
        android:fontFamily="@font/inter_medium"
        android:textSize="11sp"
        android:textColor="#5C625E"
        app:layout_constraintTop_toBottomOf="@id/itemName"
        android:layout_marginTop="1dp"
        app:layout_constraintStart_toStartOf="parent"
        />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="2dp"
        android:background="@drawable/stepper_bg"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="horizontal"

        >
        <TextView
            android:id="@+id/decBtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_inc_dec_btn"
            android:text="-"
            android:clickable="true"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:textColor="@color/btn_bg_dark"
            android:textSize="13sp"
            />

        <TextView
            android:id="@+id/itemQuantity"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="12sp"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:textColor="@color/btn_bg_dark"
            />
        <TextView
            android:id="@+id/incBtn"
            android:clickable="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_inc_dec_btn"
            android:text="+"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="@color/btn_bg_dark"
            />
        
    </LinearLayout>
    <TextView
        android:id="@+id/itemPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="13sp"
        android:fontFamily="@font/inter_semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />



</androidx.constraintlayout.widget.ConstraintLayout>