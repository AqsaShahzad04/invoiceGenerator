<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingTop="8dp"
    android:paddingBottom="28dp"
    android:paddingHorizontal="20dp">
    <View
        android:id="@+id/drag_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@drawable/drag_handle_bg"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
    
    <TextView
        android:id="@+id/add_item_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add a catalogue item"
        android:textSize="17sp"
        android:fontFamily="@font/inter_bold"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/drag_handle"
        app:layout_constraintStart_toStartOf="parent"
        android:letterSpacing="-0.015"
        />
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Name and price. unit and catagory default - \nchange later if needed"
        android:textColor="#5C625E"
        android:textSize="12sp"
        android:fontFamily="@font/inter"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/add_item_heading"
        app:layout_constraintStart_toStartOf="parent"/>
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/closebtn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/avatar_crossed_state_bg"
        android:backgroundTint="#F4F2EE"
        app:layout_constraintTop_toTopOf="@id/add_item_heading"
        android:layout_marginLeft="12dp"
        app:layout_constraintEnd_toEndOf="parent">
        
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/ic_close"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/itemNameHeading"
        android:layout_marginTop="14dp"
        android:text="item name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        android:fontFamily="@font/inter_medium"
        android:textSize="11sp"
        android:textColor="#5C625E"
        />
    <EditText
        android:id="@+id/itemNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_field"
        app:layout_constraintTop_toBottomOf="@id/itemNameHeading"
        app:layout_constraintStart_toStartOf="parent"
        android:paddingVertical="12dp"
        android:paddingHorizontal="14dp"
        android:fontFamily="@font/inter_medium"
        android:hint="e.g Basmati Rice (25Kg)"
        android:layout_marginTop="6dp"
        android:textSize="14dp"

        />

    <TextView
        android:id="@+id/priceHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Price"
        android:textSize="11sp"
        android:textColor="#5C625E"
        android:fontFamily="@font/inter_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/itemNameInput"
        />
    <EditText
        android:id="@+id/priceInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_field"
        android:text="0"
        android:fontFamily="@font/inter_medium"
        android:paddingStart="38dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:textSize="15sp"
        android:textColor="#171817"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/priceHeading"
        android:layout_marginTop="6dp"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rs"
        android:textColor="#9CA3A0"
        android:textSize="13sp"
        android:fontFamily="@font/inter_medium"
        android:layout_marginStart="14dp"
        app:layout_constraintTop_toTopOf="@id/priceInput"
        app:layout_constraintBottom_toBottomOf="@id/priceInput"
        app:layout_constraintStart_toStartOf="@id/priceInput"
/>
    <TextView
        android:id="@+id/addItemBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/green_btn_bg"
        android:text="Add item"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="14dp"
        android:textSize="14sp"
        android:fontFamily="@font/inter_semibold"
        app:layout_constraintTop_toBottomOf="@id/priceInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        />



</androidx.constraintlayout.widget.ConstraintLayout>