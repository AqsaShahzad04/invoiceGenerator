<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_cream"
    android:paddingTop="12dp"
    android:paddingHorizontal="16dp"
    android:paddingBottom="16dp">

<!--Top Card-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_workspace_box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingVertical="10dp"
        android:paddingHorizontal="14dp">

        <FrameLayout
            android:id="@+id/homelogo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:id="@+id/avatar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/avatar_circle"
                android:text="MB"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:gravity="center"
                android:fontFamily="@font/inter"
                />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:id="@+id/homeFragmentLogo"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                android:scaleType="centerCrop"
                android:visibility="gone"/>
        </FrameLayout>


        <TextView
            android:id="@+id/myBusiness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Business"
            android:fontFamily="@font/inter_semibold"
            android:textSize="12dp"
            app:layout_constraintStart_toEndOf="@id/homelogo"
            android:layout_marginLeft="8dp"
            app:layout_constraintTop_toTopOf="parent"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9CA3A0"
            android:text="▾"
            android:layout_marginLeft="8dp"
            app:layout_constraintStart_toEndOf="@+id/myBusiness"
            app:layout_constraintTop_toTopOf="parent"

            />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/homelogo"
            app:layout_constraintTop_toBottomOf="@id/myBusiness"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            >
            <FrameLayout
                android:layout_width="10dp"
                android:layout_height="10dp"
                >
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/liveDot"
                    android:background="@drawable/ripple_circle"
                    />
                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/ripple_circle"
                    android:id="@+id/mainDot"
                    android:layout_gravity="center"/>
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good evening · 10:29 PM"
                android:textSize="9sp"
                android:textColor="#9CA3A0"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.04"
                android:layout_marginStart="4dp"
                />

        </LinearLayout>


           <ImageView
               android:layout_width="16dp"
               android:layout_height="16dp"
               android:src="@drawable/ic_search"
               app:layout_constraintEnd_toStartOf="@id/bellIcon"
               app:layout_constraintTop_toTopOf="parent"
               app:layout_constraintBottom_toBottomOf="parent"
               android:layout_marginEnd="2dp"
               />
         <androidx.constraintlayout.widget.ConstraintLayout
             android:id="@+id/bellIcon"
             android:layout_width="30dp"
             android:layout_height="30dp"
             android:background="@drawable/bell_icon_bg"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintTop_toTopOf="parent"
             app:layout_constraintBottom_toBottomOf="parent"
             android:clickable="true"
             >
             <ImageView
                 android:layout_width="16dp"
                 android:layout_height="16dp"
                 android:background="@drawable/ic_notifications"
                 app:layout_constraintTop_toTopOf="parent"
                 app:layout_constraintEnd_toEndOf="parent"
                 app:layout_constraintStart_toStartOf="parent"
                 app:layout_constraintBottom_toBottomOf="parent"/>
             <view
                 class="android.widget.TextView"
                 android:layout_width="5dp"
                 android:layout_height="5dp"
                 android:background="@drawable/red_dot_notification"
                 app:layout_constraintTop_toTopOf="parent"
                 app:layout_constraintEnd_toEndOf="parent"
                 android:layout_marginTop="6dp"
                 android:layout_marginEnd="8dp"
                 />

         </androidx.constraintlayout.widget.ConstraintLayout>





    </androidx.constraintlayout.widget.ConstraintLayout>

<!-- Welcome onboarding-cards-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/homeInitialSetupCards"
        android:layout_marginTop="18dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/card1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/welcomeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_welcome_card"
        android:padding="18dp"
        >

        <view class="android.widget.ImageView"
            android:id="@+id/welcomeIconBox"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/welcome_card_icon_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/welcomeHeading"
            app:layout_constraintBottom_toBottomOf="@id/welcomesubheading"


            />

          <ImageView
              android:layout_width="19dp"
              android:layout_height="19dp"
              android:background="@drawable/welcome_card_icon"
              app:layout_constraintStart_toStartOf="@id/welcomeIconBox"
              app:layout_constraintBottom_toBottomOf="@id/welcomeIconBox"
              app:layout_constraintTop_toTopOf="@id/welcomeIconBox"
              app:layout_constraintEnd_toEndOf="@id/welcomeIconBox"

         />
        <TextView
            android:id="@+id/welcomeHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to ledger"
            android:letterSpacing="-0.02"
            android:textSize="17sp"
            android:textColor="#171817"
            android:fontFamily="@font/inter_bold"
            android:layout_marginLeft="10dp"
            app:layout_constraintStart_toEndOf="@id/welcomeIconBox"
            app:layout_constraintTop_toTopOf="parent"
            />
         <TextView
             android:id="@+id/welcomesubheading"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="A minute to setup your books"
             android:fontFamily="@font/inter"
             android:textColor="@color/subheading_color_home"
             android:textSize="11sp"
             android:layout_marginTop="1dp"
             app:layout_constraintTop_toBottomOf="@id/welcomeHeading"
             app:layout_constraintStart_toEndOf="@id/welcomeIconBox"
             android:layout_marginLeft="10dp"/>

        <view
            android:id="@+id/progressbarEmpty"
            class="android.widget.ImageView"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/empty_progress_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/progressText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/welcomesubheading" />

        <view
            android:id="@+id/progressbarFilled"
            class="android.widget.ImageView"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:background="@drawable/progess_pills_selected"
            app:layout_constraintStart_toStartOf="@id/progressbarEmpty"
            app:layout_constraintTop_toTopOf="@id/progressbarEmpty"
            app:layout_constraintBottom_toBottomOf="@id/progressbarEmpty"
            />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="0/4"
            android:textColor="@color/subheading_color_home"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/progressbarEmpty"
            app:layout_constraintBottom_toBottomOf="@id/progressbarEmpty"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/startedHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GETTING STARTED"
        android:textSize="11sp"
        android:fontFamily="@font/inter_bold"
        android:textColor="#9CA3A0"
        android:letterSpacing="0.1"
        android:paddingLeft="2dp"
        android:layout_marginTop="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcomeCard"
        />

<!--    onboarding cards-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
         android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/startedHeading"
        android:background="@drawable/bg_onboarding_steps_cards_selected"
        android:padding="14dp"
        >
      <TextView
          android:id="@+id/homeNumCircle"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:background="@drawable/home_num_circle_selected"
          android:text="1"
          android:gravity="center"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          android:textColor="@color/primary_green"
          android:textSize="13sp"
          android:fontFamily="@font/inter_bold"
          />
        <ImageView
            android:id="@+id/homeNumCircle1done"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/avatar_crossed_state_bg"
            android:src="@drawable/ic_check"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone"
            />
        <TextView
            android:id="@+id/nameWorkspace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Name your Workspace"
            android:fontFamily="@font/inter_semibold"
            android:textSize="13sp"
            android:textColor="#171817"
            app:layout_constraintStart_toEndOf="@id/homeNumCircle"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/setupBtn"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Your business name - shown on every invoice"
            android:fontFamily="@font/inter"
            android:textSize="11sp"
            android:textColor="#5C625E"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toStartOf="@id/nameWorkspace"
            app:layout_constraintTop_toBottomOf="@id/nameWorkspace"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintEnd_toStartOf="@id/setupBtn"
            />
        <Button
            android:id="@+id/setupBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/selected_button_home"
            app:backgroundTint="@null"
            android:paddingVertical="8dp"
            android:paddingHorizontal="14dp"
            android:text="Set up"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_semibold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardtwo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardone"
        android:background="@drawable/bg_onboarding_steps_cards_unselected"
        android:padding="14dp"
        >
        <TextView
            android:id="@+id/homeNumCircle2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/home_counting_cards_bg_unselected"
            android:text="2"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textColor="#9CA3A0"
            android:textSize="13sp"
            android:fontFamily="@font/inter_bold"
            />
        <ImageView
            android:id="@+id/homeNumCircle2done"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/avatar_crossed_state_bg"
            android:src="@drawable/ic_check"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone"
            />
        <TextView
            android:id="@+id/addFirstCient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Add your first client"
            android:fontFamily="@font/inter_semibold"
            android:textSize="13sp"
            android:textColor="#171817"
            app:layout_constraintStart_toEndOf="@id/homeNumCircle2"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/AddBtn"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="just a name to begin. Details can come later"
            android:fontFamily="@font/inter"
            android:textSize="11sp"
            android:textColor="#5C625E"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toStartOf="@id/addFirstCient"
            app:layout_constraintTop_toBottomOf="@id/addFirstCient"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintEnd_toStartOf="@id/AddBtn"
            />
        <Button
            android:id="@+id/AddBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/home_cards_btn_bg"
            app:backgroundTint="@null"
            android:textColor="@color/primary_green"
            android:paddingVertical="8dp"
            android:paddingHorizontal="14dp"
            android:text="Add"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_semibold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardThree"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardtwo"
        android:background="@drawable/bg_onboarding_steps_cards_unselected"
        android:padding="14dp"
        >
        <TextView
            android:id="@+id/homeNumCircle3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/home_counting_cards_bg_unselected"
            android:text="3"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textColor="#9CA3A0"
            android:textSize="13sp"
            android:fontFamily="@font/inter_bold"
            />
        <ImageView
            android:id="@+id/homeNumCircle3done"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/avatar_crossed_state_bg"
            android:src="@drawable/ic_check"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone"
            />
        <TextView
            android:id="@+id/setCurrency"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Set your currency"
            android:fontFamily="@font/inter_semibold"
            android:textSize="13sp"
            android:textColor="#171817"
            app:layout_constraintStart_toEndOf="@id/homeNumCircle3"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chooseBtn"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="How money is shown across every invoice."
            android:fontFamily="@font/inter"
            android:textSize="11sp"
            android:textColor="#5C625E"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toStartOf="@id/setCurrency"
            app:layout_constraintTop_toBottomOf="@id/setCurrency"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintEnd_toStartOf="@id/chooseBtn"
            />
        <Button
            android:id="@+id/chooseBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/home_cards_btn_bg"
            app:backgroundTint="@null"
            android:textColor="@color/primary_green"
            android:paddingVertical="8dp"
            android:paddingHorizontal="14dp"
            android:text="Choose"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_semibold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardFour"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardThree"
        android:background="@drawable/bg_onboarding_steps_cards_unselected"
        android:padding="14dp"
        >
        <TextView
            android:id="@+id/homeNumCircle4"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/home_counting_cards_bg_unselected"
            android:text="4"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textColor="#9CA3A0"
            android:textSize="13sp"
            android:fontFamily="@font/inter_bold"
            />
        <ImageView
            android:id="@+id/homeNumCircle4done"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/avatar_crossed_state_bg"
            android:src="@drawable/ic_check"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone"
            />
        <TextView
            android:id="@+id/addItems"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Add a catalogue item"
            android:fontFamily="@font/inter_semibold"
            android:textSize="13sp"
            android:textColor="#171817"
            app:layout_constraintStart_toEndOf="@id/homeNumCircle4"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/Add4Btn"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="A product or service with a price"
            android:fontFamily="@font/inter"
            android:textSize="11sp"
            android:textColor="#5C625E"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toStartOf="@id/addItems"
            app:layout_constraintTop_toBottomOf="@id/addItems"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintEnd_toStartOf="@id/Add4Btn"
            />
        <Button
            android:id="@+id/Add4Btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/home_cards_btn_bg"
            app:backgroundTint="@null"
            android:textColor="@color/primary_green"
            android:paddingVertical="8dp"
            android:paddingHorizontal="14dp"
            android:text="Add"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_semibold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

   <androidx.constraintlayout.widget.ConstraintLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="18dp"
       android:background="@drawable/home_dotted_card_bg"
       android:padding="14dp"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintTop_toBottomOf="@+id/cardFour"
       >

       <ImageView
           android:id="@+id/infoIcon"
           android:layout_width="18dp"
           android:layout_height="18dp"
           app:srcCompat="@drawable/ic_truck_info"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintTop_toTopOf="parent"
           app:layout_constraintBottom_toBottomOf="parent" />

       <TextView
           android:id="@+id/infoText"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:text="You can also add clients and items on the fly while creating an invoice."
           android:textSize="12sp"
           android:textColor="#5C625E"
           android:fontFamily="@font/inter"
           android:lineSpacingMultiplier="1.2"
           android:layout_marginStart="10dp"
           app:layout_constraintStart_toEndOf="@id/infoIcon"
           app:layout_constraintEnd_toEndOf="parent"
           app:layout_constraintTop_toTopOf="parent"
           app:layout_constraintBottom_toBottomOf="parent" />

   </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

<!--home screen actual UI-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:id="@+id/homeScreenParentCard"
        app:layout_constraintTop_toBottomOf="@id/card1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/homeStatsCardsParent"
            android:orientation="horizontal"
            >
         <androidx.constraintlayout.widget.ConstraintLayout
             android:layout_width="0dp"
             android:layout_weight="1"
             android:layout_height="wrap_content"
             android:background="@drawable/bg_home_stats_cards"
             android:padding="14dp"
             >
             <TextView
                 android:id="@+id/currentMonth"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:textSize="10sp"
                 android:text="Earned . May"
                 android:textAllCaps="true"
                 android:fontFamily="@font/inter_semibold"
                 android:textColor="@color/sectionsHeadingColor"
                 app:layout_constraintStart_toStartOf="parent"
                 app:layout_constraintTop_toTopOf="parent"
                 />
             <LinearLayout
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 app:layout_constraintEnd_toEndOf="parent"
                 app:layout_constraintTop_toTopOf="parent"
                 android:background="@drawable/live_bg"
                 android:paddingVertical="3dp"
                 android:paddingHorizontal="8dp"
                 >
                 <FrameLayout
                     android:layout_width="10dp"
                     android:layout_height="10dp"
                     >
                     <View
                         android:layout_width="match_parent"
                         android:layout_height="match_parent"
                         android:id="@+id/rippleDots"
                         android:background="@drawable/ripple_circle"
                         />
                     <View
                         android:layout_width="5dp"
                         android:layout_height="5dp"
                         android:background="@drawable/ripple_circle"
                         android:id="@+id/centerRippleCircle"
                         android:layout_gravity="center"/>
                 </FrameLayout>
                 <TextView
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="LIVE"
                     android:textSize="9sp"
                     android:fontFamily="@font/inter_semibold"
                     android:layout_marginLeft="5dp"
                     android:textColor="@color/primary_green"
                     android:letterSpacing="0.04"
                     />

             </LinearLayout>

             <TextView
                 android:id="@+id/earnedThisMonthValue"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:text="0"
                 android:fontFamily="@font/inter_bold"
                 android:textSize="26sp"
                 android:letterSpacing="-0.025"
                 android:lineSpacingMultiplier="1.1"
                 android:textColor="@color/primary_green"
                 app:layout_constraintStart_toStartOf="parent"
                 app:layout_constraintTop_toBottomOf="@id/currentMonth"
                 android:layout_marginTop="8dp"
                 />
             <LinearLayout
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:orientation="horizontal"
                 android:id="@+id/thismonthStats"
                 app:layout_constraintStart_toStartOf="parent"
                 app:layout_constraintTop_toBottomOf="@id/earnedThisMonthValue"
                 android:layout_marginTop="18dp">

                 <androidx.constraintlayout.widget.ConstraintLayout
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:background="@drawable/live_bg"
                     android:paddingVertical="3dp"
                     android:paddingHorizontal="8dp"
                     >
                     <ImageView
                         android:id="@+id/insightArrow"
                         android:layout_width="10dp"
                         android:layout_height="10dp"
                         android:background="@drawable/insights_upper_arrow"
                         app:layout_constraintStart_toStartOf="parent"
                         app:layout_constraintTop_toTopOf="parent"
                         app:layout_constraintBottom_toBottomOf="parent"
                         />
                     <TextView
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:text="+18.2%"
                         app:layout_constraintStart_toEndOf="@id/insightArrow"
                         android:textSize="10sp"
                         android:layout_marginStart="4dp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="@color/primary_green"
                         app:layout_constraintTop_toTopOf="parent"
                         app:layout_constraintBottom_toBottomOf="parent"/>

                 </androidx.constraintlayout.widget.ConstraintLayout>

               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="vs April"
                   android:textSize="10sp"
                   android:textColor="@color/subheading_color_home"
                   android:layout_marginStart="6dp"
                   android:fontFamily="@font/inter_medium"
                   android:layout_gravity="center"
                   />


             </LinearLayout>





         </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/outstandingCard"
                android:layout_marginStart="8dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_stats_cards"
                android:padding="14dp"
                >
                <TextView
                    android:id="@+id/outstandingHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:text="Outstanding"
                    android:textAllCaps="true"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/sectionsHeadingColor"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />
                <TextView
                    android:id="@+id/outstandingValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="18sp"
                    android:letterSpacing="-0.025"
                    android:lineSpacingMultiplier="1.1"
                    android:textColor="@color/btn_bg_dark"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/outstandingHeading"
                    android:layout_marginTop="6dp"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/pendingOrunpaidstats"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/outstandingValue"
                    android:layout_marginTop="10dp">

                   <LinearLayout
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:orientation="horizontal"
                       android:id="@+id/unpaid_row"
                       >
                       <view class="android.widget.ImageView"
                           android:layout_width="6dp"
                           android:layout_height="6dp"
                           android:background="@drawable/unpaid_circle"
                           android:layout_marginRight="6dp"
                           android:layout_gravity="center"
                           />
                       <TextView
                           android:id="@+id/unpaidHeading"
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:text="unpaid"
                           android:textSize="11sp"
                           android:fontFamily="@font/inter_medium"
                           android:textColor="@color/subheading_color_home"/>
                       <Space
                           android:layout_width="0dp"
                           android:layout_height="0dp"
                           android:layout_weight="1" />
                       <TextView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:text="0"
                           android:textSize="11sp"
                           android:fontFamily="@font/inter_bold"
                           />


                   </LinearLayout>

                    <view class="android.widget.ImageView"
                      android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#0F171817"
                        android:layout_marginVertical="6dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:id="@+id/pending_row"
                        >
                        <view class="android.widget.ImageView"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/pending_circle"
                            android:layout_marginRight="6dp"
                            android:layout_gravity="center"
                            />
                        <TextView
                            android:id="@+id/pendingHeading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="pending"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/subheading_color_home"/>
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_bold"
                            />


                    </LinearLayout>



                </LinearLayout>





            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/secondRowCards"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:paddingHorizontal="13dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_home_stats_cards">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_home_catalogue"
                android:id="@+id/catalogue_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                >
                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:background="@drawable/ic_package"
                    android:backgroundTint="@color/subheading_color_home"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />


            </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/catalogueHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catalogue"
                    android:textSize="13sp"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/inter_semibold"
                    app:layout_constraintStart_toEndOf="@id/catalogue_icon"
                    app:layout_constraintTop_toTopOf="@id/catalogue_icon"
                    />
                <TextView
                    android:id="@+id/noOfItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 item"
                    android:layout_marginTop="1dp"
                    android:layout_marginStart="10dp"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/subheading_color_home"
                    app:layout_constraintTop_toBottomOf="@id/catalogueHeading"
                    app:layout_constraintStart_toEndOf="@id/catalogue_icon"/>
                
                <ImageView
                    android:id="@+id/catalogue_Chiv"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_chivron_right"
                    android:layout_marginStart="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                />
            </androidx.constraintlayout.widget.ConstraintLayout>




            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:paddingHorizontal="13dp"
                android:background="@drawable/bg_home_stats_cards">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_home_catalogue"
                    android:id="@+id/client_icon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    >
                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:background="@drawable/ic_poeple"
                        android:backgroundTint="@color/subheading_color_home"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/clientHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Client"
                    android:textSize="13sp"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/inter_semibold"
                    app:layout_constraintStart_toEndOf="@id/client_icon"
                    app:layout_constraintTop_toTopOf="@id/client_icon"
                    />
                <TextView
                    android:id="@+id/noOfClients"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 client"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginTop="1dp"
                    android:layout_marginStart="10dp"
                    android:textSize="11sp"
                    android:textColor="@color/subheading_color_home"
                    app:layout_constraintTop_toBottomOf="@id/clientHeading"
                    app:layout_constraintStart_toEndOf="@id/client_icon"/>

                <ImageView
                    android:id="@+id/client_chiv"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_chivron_right"
                    android:layout_marginStart="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent activity"
                android:textSize="13sp"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="-0.01"
                android:textColor="@color/btn_bg_dark"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View all →"
                android:textColor="@color/primary_green"
                android:textSize="12sp"
                android:fontFamily="@font/inter_medium"
                />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/invoice_rv"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="32dp"
            android:text="No invoices yet"
            android:gravity="center"
            android:textColor="@color/sectionsHeadingColor"
            android:textSize="13sp"
            android:fontFamily="@font/inter_medium"/>
    </LinearLayout>

















    </androidx.constraintlayout.widget.ConstraintLayout>
