<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_currency_picker_sheet"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="28dp">

    <view class="android.widget.ImageView"
        android:id="@+id/dragHandleCurrency"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/drag_handle_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/currencyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Numbering reset"
        android:fontFamily="@font/inter_bold"
        android:textSize="17sp"
        android:letterSpacing="-0.015"
        android:layout_marginTop="14dp"
        android:textColor="@color/btn_text_dark"
        app:layout_constraintTop_toBottomOf="@id/dragHandleCurrency"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/currencySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:text="When the invoice counter goes back to 0001"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/subheading_color_home"
        android:lineSpacingMultiplier="1.5"
        app:layout_constraintTop_toBottomOf="@id/currencyTitle"
        app:layout_constraintStart_toStartOf="parent"
        />
    <ImageButton
        android:id="@+id/closebtn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_cross_button"
        android:backgroundTint="#F4F2EE"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/currencyTitle"
        app:layout_constraintBottom_toBottomOf="@id/currencyTitle"/>



    <LinearLayout
        android:id="@+id/yearlySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/currencySubtitle"
        android:layout_marginTop="14dp">

        <LinearLayout
            android:id="@+id/yearly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:paddingHorizontal="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/yearlyHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YEARLY"
                        android:textColor="@color/btn_bg_dark"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_semibold"
                        />
                    <TextView
                        android:id="@+id/yearlysubHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Counter restarts every january"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/subheading_color_home"
                        />
                </LinearLayout>
                <RadioButton
                    android:id="@+id/yearlyRadioBtn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:checked="true"
                    android:button="@null"
                    android:background="@drawable/selector_currency_state"
                    />

            </LinearLayout>

            <view class="android.widget.ImageView"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#0F171817"
                />


        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/monthlySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/yearlySection"
        >

        <LinearLayout
            android:id="@+id/monthly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:paddingHorizontal="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/monthlyHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monthly"
                        android:textColor="@color/btn_bg_dark"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_semibold"
                        />
                    <TextView
                        android:id="@+id/currencyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Counter restarts every month"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/subheading_color_home"
                        />
                </LinearLayout>
                <RadioButton
                    android:id="@+id/monthlyRadioBtn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:checked="false"
                    android:button="@null"
                    android:background="@drawable/selector_currency_state"
                    />

            </LinearLayout>

            <view class="android.widget.ImageView"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#0F171817"
                />


        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/neverSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/monthlySection"
        >

        <LinearLayout
            android:id="@+id/never"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:paddingHorizontal="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/neverHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Never"
                        android:textColor="@color/btn_bg_dark"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_semibold"
                        />
                    <TextView
                        android:id="@+id/neverSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="One sequence forever"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/subheading_color_home"
                        />
                </LinearLayout>
                <RadioButton
                    android:id="@+id/neverRadioBtn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:checked="false"
                    android:button="@null"
                    android:background="@drawable/selector_currency_state"
                    />

            </LinearLayout>

            <view class="android.widget.ImageView"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#0F171817"
                />


        </LinearLayout>

    </LinearLayout>

    <Button
        android:layout_marginTop="18dp"
        android:id="@+id/doneBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Done"
        android:paddingHorizontal="14dp"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/bg_cream"
        app:backgroundTint="@null"
        android:background="@drawable/green_btn_bg"
        android:backgroundTint="@color/btn_bg_dark"
        app:layout_constraintTop_toBottomOf="@id/neverSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />





</androidx.constraintlayout.widget.ConstraintLayout>