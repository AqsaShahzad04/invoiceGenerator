<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="514dp"
    android:maxHeight="514dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_currency_picker_sheet"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="28dp">

    <view class="android.widget.ImageView"
        android:id="@+id/dragHandleCurrency"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/drag_handle_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/currencyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Currency"
        android:fontFamily="@font/inter_bold"
        android:textSize="17sp"
        android:letterSpacing="-0.015"
        android:layout_marginTop="14dp"
        android:textColor="@color/btn_text_dark"
        app:layout_constraintTop_toBottomOf="@id/dragHandleCurrency"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/currencySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:text="Applies to invoices,items and totals"
        android:layout_marginTop="4dp"
        android:textColor="@color/subheading_color_home"
        android:lineSpacingMultiplier="1.5"
        app:layout_constraintTop_toBottomOf="@id/currencyTitle"
        app:layout_constraintStart_toStartOf="parent"
/>
    <ImageButton
        android:id="@+id/closebtn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_cross_button"
        android:backgroundTint="#F4F2EE"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/currencyTitle"
        app:layout_constraintBottom_toBottomOf="@id/currencyTitle"/>



    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/currencySubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="14dp"
        android:id="@+id/currencyRv"/>





</androidx.constraintlayout.widget.ConstraintLayout>