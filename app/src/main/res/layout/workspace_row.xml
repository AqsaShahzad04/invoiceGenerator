<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/workspaceAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/avatar_circle"
        android:backgroundTint="#0C861A"
        android:fontFamily="@font/inter_bold"
        android:gravity="center"
        android:text="AE"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/workspaceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Ayesha Enterprises"
        android:textColor="#171817"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/activeIndicator"
        app:layout_constraintStart_toEndOf="@id/workspaceAvatar"
        app:layout_constraintTop_toTopOf="@id/workspaceAvatar" />

    <TextView
        android:id="@+id/workspaceSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text="info@ayesha.pk"
        android:textColor="#9CA3A0"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/workspaceName"
        app:layout_constraintStart_toStartOf="@id/workspaceName"
        app:layout_constraintTop_toBottomOf="@id/workspaceName" />

    <TextView
        android:id="@+id/activeIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/inter_bold"
        android:text="ACTIVE"
        android:textColor="#22A06B"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/arrowRight"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/arrowRight"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_back"
        android:rotation="180"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#E8E5DF" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#F1F0EC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/workspaceName"
        app:layout_constraintTop_toBottomOf="@id/workspaceSubtitle" />

</androidx.constraintlayout.widget.ConstraintLayout>