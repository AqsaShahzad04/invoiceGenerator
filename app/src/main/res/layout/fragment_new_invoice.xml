<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:background="@color/bg_cream">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerSectionNewInvoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <ImageView
            android:id="@+id/iconBackInvoice"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_backbtn_edit"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New invoice"
            android:fontFamily="@font/inter_semibold"
            android:textSize="13sp"
            android:textColor="@color/btn_bg_dark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
        <TextView
            android:id="@+id/cancelBtnInvoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/subheading_color_home"
            android:textSize="12sp"
            android:fontFamily="@font/inter_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/indicatorsInvoiceSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerSectionNewInvoice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="horizontal"
        >
        <LinearLayout

            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <view class="android.widget.LinearLayout"
                android:id="@+id/clientIdicator"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_invoice_step_indicators_selected"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CLIENT"
                android:gravity="center"
                android:textSize="10sp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.06"
                android:layout_marginTop="8dp"
                android:textColor="@color/primary_green"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <view
                android:id="@+id/itemsIndicator"
                class="android.widget.LinearLayout"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_invoice_step_indicators_unselected"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ITEMS"
                android:gravity="center"
                android:textSize="10sp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.06"
                android:layout_marginTop="8dp"
                android:textColor="@color/sectionsHeadingColor"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <view
                android:id="@+id/detailsIndicator"
                class="android.widget.LinearLayout"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_invoice_step_indicators_unselected"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DETAILS"
                android:gravity="center"
                android:textSize="10sp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.06"
                android:layout_marginTop="8dp"
                android:textColor="@color/sectionsHeadingColor"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <view
                android:id="@+id/reviewIdicator"
                class="android.widget.LinearLayout"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_invoice_step_indicators_unselected"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REVIEW"
                android:gravity="center"
                android:textSize="10sp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.06"
                android:layout_marginTop="8dp"
                android:textColor="@color/sectionsHeadingColor"
                />
        </LinearLayout>

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/newInvoiceNavHost"
        android:name="androidx.navigation.fragment.NavHostFragment"
        app:navGraph="@navigation/new_invoice_nav_graph"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/indicatorsInvoiceSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/indicatorsInvoiceSection"
        app:layout_constraintBottom_toBottomOf="parent"

        />





</androidx.constraintlayout.widget.ConstraintLayout>