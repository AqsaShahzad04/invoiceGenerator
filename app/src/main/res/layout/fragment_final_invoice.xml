<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FBFAF7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- Top bar: back arrow, "Invoice" title, Mark paid + delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Invoice"
                android:textColor="#171817"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Mark paid: icon + text as ImageView+TextView instead of drawableStart -->
                <LinearLayout
                    android:id="@+id/btnMarkPaid"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_back_btn_items"
                    android:backgroundTint="#22A06B"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_check"
                        android:contentDescription="@null"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="Mark paid"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_back_btn_items"
                    android:src="@drawable/ic_trash"
                    android:contentDescription="Delete"
                    app:tint="#D9534F" />

            </LinearLayout>
        </LinearLayout>

        <!-- White invoice card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_invoice_sheet"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Business name + NTN, dashed line below -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="#32520e"
                android:orientation="vertical"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ayesha space"
                    android:textColor="@color/bg_cream"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="NTN"
                    android:textColor="@color/bg_cream"
                    android:textSize="10sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/dashed_divider" />

            <!-- Invoice number (left) + Unpaid status (right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INVOICE"
                        android:textColor="#9CA3A0"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvInvoiceNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="##00002"
                        android:textColor="#171817"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/pending_circle"
                        android:backgroundTint="@color/carrot_red_shade" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unpaid"
                        android:textColor="#D9534F"
                        android:textSize="11sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Bill to (left) + Date (right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BILL TO"
                        android:textColor="#9CA3A0"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvClientName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="cllient-2"
                        android:textColor="#171817"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATE"
                        android:textColor="#9CA3A0"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="20 Sept 2026"
                        android:textColor="#171817"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDueDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Due 04 Nov 2026"
                        android:textColor="#5C625E"
                        android:textSize="11sp" />

                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/dashed_divider" />

            <!-- Item table header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ITEM"
                    android:textColor="#9CA3A0"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="QTY"
                    android:textColor="#9CA3A0"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="AMOUNT"
                    android:textColor="#9CA3A0"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Item row(s): this one goes in a RecyclerView if there are
                 multiple items; shown here as the single "daal" row from
                 the screenshot -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvItemName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="daal"
                        android:textColor="#171817"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvItemRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Rs 300 / piece"
                        android:textColor="#9CA3A0"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvItemQty"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#171817"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvItemAmount"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="300"
                    android:textColor="#171817"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/dashed_divider" />

            <!-- Totals block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Subtotal"
                        android:textColor="#5C625E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rs 300"
                        android:textColor="#5C625E"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Discount (15%)"
                        android:textColor="#0C861A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDiscount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="− Rs 45"
                        android:textColor="#0C861A"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tax (10%)"
                        android:textColor="#5C625E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rs 26"
                        android:textColor="#5C625E"
                        android:textSize="12sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/dashed_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total"
                        android:textColor="#171817"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rs 281"
                        android:textColor="#171817"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>

            <!-- Payment note -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:paddingTop="12dp"
                android:text="Please reference the invoice number when paying."
                android:textColor="#5C625E"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/dashed_divider" />

            <!-- Thank you footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="— THANK YOU —"
                android:textColor="#9CA3A0"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Bottom action buttons: Send, Share, Download -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Send: icon + text as ImageView+TextView instead of drawableStart -->
            <LinearLayout
                android:id="@+id/btnSend"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_black"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_send"
                    android:contentDescription="@null"
                    app:tint="#FBFAF7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send"
                    android:textAllCaps="false"
                    android:textColor="#FBFAF7"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Share: icon + text as ImageView+TextView instead of drawableStart -->
            <LinearLayout
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_share"
                    android:contentDescription="@null"
                    app:tint="#171817" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share"
                    android:textAllCaps="false"
                    android:textColor="#171817"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDownload"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_outline"
                android:padding="12dp"
                android:src="@drawable/ic_download"
                android:contentDescription="Download"
                app:tint="#171817" />

        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change header colors:"
            android:fontFamily="@font/inter_medium"
            android:textSize="16sp"
            android:paddingStart="16dp"
            android:textColor="@color/subheading_color_home"
            android:layout_marginTop="46dp"
            />



        <!-- Header color options: user taps a dot to change the header background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/dotGreenWrap"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp">

                <View
                    android:id="@+id/dotGreenRing"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/color_dot_ring"
                    android:visibility="visible" />

                <View
                    android:id="@+id/dotGreen"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/color_dot"
                    android:backgroundTint="#32520e"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/dotBlueWrap"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp">

                <View
                    android:id="@+id/dotBlueRing"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/color_dot_ring"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dotBlue"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/color_dot"
                    android:backgroundTint="#6797b8"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/dotPurpleWrap"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp">

                <View
                    android:id="@+id/dotPurpleRing"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/color_dot_ring"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dotPurple"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/color_dot"
                    android:backgroundTint="#591D1C"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/dotOrangeWrap"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp">

                <View
                    android:id="@+id/dotOrangeRing"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/color_dot_ring"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dotOrange"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/color_dot"
                    android:backgroundTint="#154360"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/dotPinkWrap"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp">

                <View
                    android:id="@+id/dotPinkRing"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/color_dot_ring"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dotPink"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/color_dot"
                    android:backgroundTint="#a84b83"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/dotDarkWrap"
                android:layout_width="32dp"
                android:layout_height="32dp">

                <View
                    android:id="@+id/dotDarkRing"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/color_dot_ring"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dotDark"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/color_dot"
                    android:backgroundTint="#171817"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>
            <FrameLayout
                android:id="@+id/noColorWrap"
                android:layout_width="32dp"
                android:layout_height="32dp">

                <View
                    android:id="@+id/noColorRing"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/color_dot_ring"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dotDark"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ic_color_none"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>