<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/bg_cream"
    android:paddingHorizontal="28dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">


    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="01/03"
        android:fontFamily="@font/inter_medium"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/skipbtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Skip"
        android:clickable="true"
        android:fontFamily="@font/inter_medium"
        android:textSize="13sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/textView"
        app:layout_constraintEnd_toEndOf="parent" />

    <view
        android:id="@+id/icon_bg"
        class="androidx.constraintlayout.helper.widget.Grid"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:layout_constraintVertical_bias="0.36" />

    <ImageView
        android:id="@+id/iconitself"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@id/icon_bg"
        app:layout_constraintEnd_toEndOf="@id/icon_bg"
        app:layout_constraintStart_toStartOf="@id/icon_bg"
        app:layout_constraintTop_toTopOf="@id/icon_bg"
        app:srcCompat="@drawable/ic_onboarding_one" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/inter_bold"
        android:text="Compose invoices in \nfour steps"
        android:textColor="#171817"
        android:textSize="28sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_bg"
        app:layout_constraintWidth="match_constraint" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:width="0dp"
        android:fontFamily="@font/inter"
        android:lineSpacingMultiplier="1.25"
        android:text="Client. Items. Details. Review. A guided flow that handles the math, the tax and the totals."
        android:textColor="#5C625E"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <View
        android:id="@+id/pillone"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/progess_pills_selected"
        app:layout_constraintBottom_toTopOf="@id/button"
        android:layout_marginBottom="22dp"
        app:layout_constraintEnd_toStartOf="@+id/pillthree"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/pilltwo"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@drawable/progress_pills"
        app:layout_constraintBottom_toBottomOf="@+id/pillone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        android:layout_marginEnd="6dp"
        app:layout_constraintStart_toEndOf="@+id/pillthree" />

    <View
        android:id="@+id/pillthree"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/progress_pills"
        app:layout_constraintBottom_toBottomOf="@+id/pillone"
        app:layout_constraintEnd_toStartOf="@+id/pilltwo"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/pillone" />

    <Button
        android:id="@+id/button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_continue_btn"
        android:fontFamily="@font/inter"
        android:paddingHorizontal="14dp"
        android:text="Continue"
        android:textColor="#FBFAF7"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/btn_bg_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
         />


</androidx.constraintlayout.widget.ConstraintLayout>