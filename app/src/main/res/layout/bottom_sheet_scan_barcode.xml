<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingTop="8dp"
    android:paddingBottom="28dp"
    android:paddingHorizontal="20dp">
    <View
        android:id="@+id/drag_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@drawable/drag_handle_bg"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/scan_barcode_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scan barcode"
        android:textSize="17sp"
        android:fontFamily="@font/inter_bold"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/drag_handle"
        app:layout_constraintStart_toStartOf="parent"
        android:letterSpacing="-0.015"
        />
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Point at a barcode to capture its number then- \nfill in the product details"
        android:textColor="#5C625E"
        android:textSize="12sp"
        android:fontFamily="@font/inter"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/scan_barcode_heading"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/closebtn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/avatar_crossed_state_bg"
        android:backgroundTint="#F4F2EE"
        app:layout_constraintTop_toTopOf="@id/scan_barcode_heading"
        android:layout_marginLeft="12dp"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/ic_close"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scanBox"
        android:layout_width="match_parent"
        android:layout_height="188dp"
        android:background="@drawable/scan_barcode_box_bg"
        android:layout_marginTop="14dp"

        android:clipToOutline="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitle">
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <ImageView
            android:id="@+id/bracketTopLeft"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="16dp"
            android:src="@drawable/ic_corner_brackets"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/bracketTopRight"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="16dp"
            android:rotation="90"
            android:src="@drawable/ic_corner_brackets"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/bracketBottomRight"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="16dp"
            android:rotation="180"
            android:src="@drawable/ic_corner_brackets"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/bracketBottomLeft"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="16dp"
            android:rotation="270"
            android:src="@drawable/ic_corner_brackets"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/ic_barcode"
            android:alpha="0.25"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
        <view class="android.widget.ImageView"
            android:id="@+id/scanLine"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:background="@drawable/scan_line"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="16dp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/barcodeNumHeading"
        android:layout_marginTop="14dp"
        android:text="Barcode number"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scanBox"
        android:fontFamily="@font/inter_medium"
        android:textSize="11sp"
        android:textColor="#5C625E"
        />
    <EditText
        android:id="@+id/barcodeNumInput"
        android:layout_width="0dp"
        app:layout_constraintVertical_weight="1"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_field"
        app:layout_constraintEnd_toStartOf="@id/useCodeBtn"
        app:layout_constraintTop_toBottomOf="@id/barcodeNumHeading"
        app:layout_constraintStart_toStartOf="parent"
        android:paddingVertical="12dp"
        android:paddingHorizontal="14dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/inter_medium"
        android:hint="Scan, or type a number"
        android:layout_marginTop="6dp"
        android:textSize="14dp"

        />
    <TextView
        android:id="@+id/useCodeBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/green_btn_bg"
        android:text="Use"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="14dp"
        android:textSize="14sp"
        android:fontFamily="@font/inter_semibold"
        app:layout_constraintTop_toBottomOf="@id/barcodeNumHeading"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"
        />

    <TextView
        android:id="@+id/simulateScanHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SIMULATE A SCAN"
        android:textSize="11sp"
        android:textColor="#9CA3A0"
        android:fontFamily="@font/inter_semibold"
        android:letterSpacing="0.08"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barcodeNumInput"
        />
    <EditText
        android:id="@+id/unknownCodeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/home_dotted_card_bg"
        android:text="Unkown code"
        android:fontFamily="@font/inter_semibold"
        android:paddingStart="38dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:textSize="11sp"
        android:textColor="#5C625E"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/simulateScanHeading"
        android:layout_marginTop="6dp"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_barcode"
        android:textColor="#9CA3A0"
        android:textSize="13sp"
        android:fontFamily="@font/inter_medium"
        android:layout_marginStart="14dp"
        app:layout_constraintTop_toTopOf="@id/unknownCodeText"
        app:layout_constraintBottom_toBottomOf="@id/unknownCodeText"
        app:layout_constraintStart_toStartOf="@id/unknownCodeText"
        />




</androidx.constraintlayout.widget.ConstraintLayout>