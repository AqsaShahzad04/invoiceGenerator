<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FBFAF7"
   >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headingsections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingTop="8dp"
        android:paddingHorizontal="16dp"
        >


        <view
            android:id="@+id/backbtnbg"
            class="android.widget.ImageView"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_backbtn_edit"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/backbtn"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:background="@drawable/ic_back"
        app:layout_constraintTop_toTopOf="@id/backbtnbg"
        app:layout_constraintBottom_toBottomOf="@id/backbtnbg"
        app:layout_constraintStart_toStartOf="@id/backbtnbg"
        app:layout_constraintEnd_toEndOf="@id/backbtnbg"
        />

        <TextView
            android:id="@+id/clientHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_semibold"
            android:text="Client"
            android:textColor="#171817"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/editbtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_ic_edit_client"
            android:scaleType="centerInside"
            android:src="@drawable/ic_pensil"
            app:layout_constraintEnd_toStartOf="@id/trashbutton"
            app:layout_constraintTop_toTopOf="@id/clientHeading"
            app:layout_constraintBottom_toBottomOf="@id/clientHeading"/>
         <ImageButton
             android:id="@+id/trashbutton"
             android:layout_width="36dp"
             android:layout_height="36dp"
             android:src="@drawable/ic_trash"
             android:background="@drawable/bg_ic_edit_client"
             android:scaleType="centerInside"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintTop_toTopOf="@id/clientHeading"
             app:layout_constraintBottom_toBottomOf="@id/clientHeading"
             />


    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profileSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="14dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headingsections">
        
        <TextView
            android:id="@+id/profileCircle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/client_profile_circle_bg"
            android:text="Z"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:textSize="20dp"
            android:textColor="#FFFFFF"
            android:letterSpacing="-0.02"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
        <TextView
            android:id="@+id/businessName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zosh"
            android:fontFamily="@font/inter_bold"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@id/profileCircle"
            android:layout_marginStart="14dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textColor="#171817"
/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/statsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/profileSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/totalbilledSection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_stats_cards_edit_client"
            android:padding="14dp"
            app:layout_constraintEnd_toStartOf="@+id/constraintLayout"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/totalBilled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="TOTAL BILLED"
                android:textColor="#9CA3A0"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/totalBilledValuecurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="$"
                android:textColor="#171817"
                android:textSize="17sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/totalBilled" />
            <TextView
                android:id="@+id/totalbill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:layout_marginStart="4dp"
                android:text="0"
                android:textColor="#171817"
                android:textSize="17sp"
                app:layout_constraintStart_toEndOf="@id/totalBilledValuecurrency"
                app:layout_constraintTop_toTopOf="@id/totalBilledValuecurrency"
                app:layout_constraintBottom_toBottomOf="@id/totalBilledValuecurrency"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_stats_cards_edit_client"
            android:padding="14dp"
            app:layout_constraintBottom_toBottomOf="@id/totalbilledSection"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/totalbilledSection"
            app:layout_constraintTop_toTopOf="@id/totalbilledSection">

            <TextView
                android:id="@+id/outstanding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="OUTSTANDING"
                android:textColor="#9CA3A0"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/outstandingValuecurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="$"
                android:textColor="#171817"
                android:textSize="17sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/outstanding" />

            <TextView
                android:id="@+id/outstandingValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:layout_marginStart="4dp"
                android:text="0"
                android:textColor="#171817"
                android:textSize="17sp"
                app:layout_constraintStart_toEndOf="@id/outstandingValuecurrency"
                app:layout_constraintTop_toTopOf="@id/outstandingValuecurrency"
                app:layout_constraintBottom_toBottomOf="@id/outstandingValuecurrency"
                />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/userDetailsSections"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statsSection">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/detailsCardInner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_client_details_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/emailCard"
                android:paddingHorizontal="12dp"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/emailIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_client_details_icons"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_email"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/clientMail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Add email Address"
                    android:textColor="#0C861A"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/emailIcon"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/emailAddBtn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_plus_icons"
                    android:src="@drawable/ic_plus"
                    android:scaleType="centerInside"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#EFEDE7"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/emailIcon" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/phoneCard"
                android:paddingHorizontal="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/emailCard">

                <ImageView
                    android:id="@+id/phoneIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_client_details_icons"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_phone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/clientNum"
                    android:inputType="phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Phone number"
                    android:fontFamily="@font/inter_semibold"
                    android:textSize="12sp"
                    android:textColor="#0C861A"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/phoneIcon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/phoneAddBtn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_plus_icons"
                    android:src="@drawable/ic_plus"
                    android:scaleType="centerInside"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#EFEDE7"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/phoneIcon" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/addressCard"
                android:padding="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/phoneCard"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/addressIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_client_details_icons"
                    android:src="@drawable/ic_address"
                    android:scaleType="centerInside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/clientAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add billing Address"
                    android:fontFamily="@font/inter_semibold"
                    android:textSize="12sp"
                    android:textColor="#0C861A"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/addressIcon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/addressAddBtn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_plus_icons"
                    android:src="@drawable/ic_plus"
                    android:scaleType="centerInside"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/invoicesHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/userDetailsSections"
        android:layout_marginTop="18dp"
        android:paddingHorizontal="16dp"
        >

        <TextView
            android:id="@+id/invoicesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invoices"
            android:fontFamily="@font/inter_semibold"
            android:textSize="13sp"
            android:textColor="#171817"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(0)"
            android:fontFamily="@font/inter_medium"
            android:textSize="11sp"
            android:textColor="#9CA3A0"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@id/invoicesText"
            app:layout_constraintTop_toTopOf="@id/invoicesText"
            app:layout_constraintBottom_toBottomOf="@id/invoicesText" />
        <TextView
            android:id="@+id/noInvoicesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No invoices for this client yet."
            android:textSize="12sp"
            android:textColor="#9CA3A0"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/invoicesText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
