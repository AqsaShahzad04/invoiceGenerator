<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_currency_picker_sheet"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="28dp">

    <!-- Drag handle -->
    <view class="android.widget.ImageView"
        android:id="@+id/dragHandleDateFilter"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/drag_handle_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Title -->
    <TextView
        android:id="@+id/filterTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter by date"
        android:fontFamily="@font/inter_bold"
        android:textSize="17sp"
        android:letterSpacing="-0.015"
        android:layout_marginTop="14dp"
        android:textColor="@color/btn_text_dark"
        app:layout_constraintTop_toBottomOf="@id/dragHandleDateFilter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/closeBtnDateFilter"
        app:layout_constraintHorizontal_bias="0"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/filterSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:text="Pick a range to view invoices from."
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:textColor="@color/subheading_color_home"
        android:lineSpacingMultiplier="1.5"
        app:layout_constraintTop_toBottomOf="@id/filterTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/closeBtnDateFilter"/>

    <!-- Close button -->
    <ImageButton
        android:id="@+id/closeBtnDateFilter"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_cross_button"
        android:backgroundTint="@color/greyish_white"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/filterTitle"
        app:layout_constraintBottom_toBottomOf="@id/filterTitle"/>

    <!-- Quick-select grid: 4 rows x 2 columns -->
    <LinearLayout
        android:id="@+id/quickRangeGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/filterSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: Today / Yesterday -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnToday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="Today"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/btn_text_dark"
                android:gravity="start|center_vertical"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnYesterday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="Yesterday"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/btn_text_dark"
                android:gravity="start|center_vertical"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Row 2: This week / This month (selected) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/btnThisWeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="This week"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/btn_text_dark"
                android:gravity="start|center_vertical"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnThisMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/green_btn_bg"
                android:backgroundTint="@color/primary_green"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="This month"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/bg_cream"
                android:gravity="start|center_vertical"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Row 3: Last month / Last 3 months -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/btnLastMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="Last month"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/btn_text_dark"
                android:gravity="start|center_vertical"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnLast3Months"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="Last 3 months"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/btn_text_dark"
                android:gravity="start|center_vertical"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Row 4: This year / All time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/btnThisYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="This year"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/btn_text_dark"
                android:gravity="start|center_vertical"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnAllTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="All time"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/btn_text_dark"
                android:gravity="start|center_vertical"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Custom range label -->
    <TextView
        android:id="@+id/customRangeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Custom range"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:letterSpacing="0.1"
        android:fontFamily="@font/inter_semibold"
        android:textSize="10sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/quickRangeGrid"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- From / To row -->
    <LinearLayout
        android:id="@+id/dateRangeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/customRangeLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From"
                android:textSize="10sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/subheading_color_home"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/fromDateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:textSize="12sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/btn_text_dark"
                android:hint="mm/dd/yyyy"
                android:drawableEnd="@drawable/ic_calender_2"
                android:inputType="date"
                android:focusable="false"
                android:clickable="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To"
                android:textSize="10sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/subheading_color_home"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/toDateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:textSize="12sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/btn_text_dark"
                android:hint="mm/dd/yyyy"
                android:drawableEnd="@drawable/ic_calender_2"
                android:inputType="date"
                android:focusable="false"
                android:clickable="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Apply button -->
    <Button
        android:id="@+id/applyBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apply"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/bg_cream"
        app:backgroundTint="@null"
        android:background="@drawable/green_btn_bg"
        android:backgroundTint="@color/btn_bg_dark"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/dateRangeRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>