<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingVertical="12dp"
    android:paddingHorizontal="16dp"
    android:background="@color/bg_cream">
    <TextView
    android:id="@+id/reviewAndCreateHeading"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Review &amp; create"
    android:textSize="20sp"
    android:fontFamily="@font/inter_bold"
    android:letterSpacing="-0.015"
    android:textColor="@color/btn_bg_dark"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"

    />
    <TextView
        android:id="@+id/reviewSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Looks right? you can still edit afterwards"
        android:textSize="13sp"
        android:textColor="#5C625E"
        android:fontFamily="@font/inter_medium"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/reviewAndCreateHeading"
        app:layout_constraintStart_toStartOf="parent"
        />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fromToSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:background="@drawable/bg_review_invoice_box"
        app:layout_constraintTop_toBottomOf="@id/reviewSubtitle"
        android:layout_marginTop="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:id="@+id/fromSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ToSection"
            android:paddingEnd="10dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/fromHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FROM"
                android:textSize="9sp"
                android:textColor="#9CA3A0"
                android:letterSpacing="0.08"
                android:fontFamily="@font/inter_semibold"

                />
            <TextView
                android:id="@+id/myWorkspaceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workspace name"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:textColor="@color/btn_bg_dark"
                android:fontFamily="@font/inter_semibold"
                />

        </LinearLayout>
        <LinearLayout
            android:id="@+id/ToSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/fromSection"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ToHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TO"
                android:textSize="9sp"
                android:textColor="#9CA3A0"
                android:letterSpacing="0.08"
                android:fontFamily="@font/inter_semibold"

                />
            <TextView
                android:id="@+id/clientsusinessName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="clientBusiness name"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:textColor="@color/btn_bg_dark"
                android:fontFamily="@font/inter_semibold"
                />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/billingDetailsBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:background="@drawable/bg_review_invoice_box"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/fromToSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <TextView
            android:id="@+id/numOfItemsHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 ITEMS"
            android:textSize="9sp"
            android:textColor="#9CA3A0"
            android:letterSpacing="0.08"
            android:fontFamily="@font/inter_semibold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />
       <androidx.recyclerview.widget.RecyclerView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:id="@+id/itemDetailsRow"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toEndOf="parent"
           app:layout_constraintTop_toBottomOf="@id/numOfItemsHeading"
           android:layout_marginTop="10dp"
           />

        <view class="android.widget.TextView"
            android:id="@+id/itemsDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/greyish_white"
            app:layout_constraintTop_toBottomOf="@id/itemDetailsRow"
            android:layout_marginTop="8dp"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/billingCountSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/itemsDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/subtotalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subtotal"
                android:textColor="#5C625E"
                android:fontFamily="@font/inter_medium"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/subtotalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs 800"
                android:textColor="#5C625E"
                android:fontFamily="@font/inter_medium"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/subtotalLabel"
                app:layout_constraintBottom_toBottomOf="@id/subtotalLabel" />

            <TextView
                android:id="@+id/discountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discount (20%)"
                android:textColor="#5C625E"
                android:fontFamily="@font/inter_medium"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subtotalLabel" />
            <TextView
                android:id="@+id/discountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="_AED 200"
                android:textColor="@color/primary_green"
                android:fontFamily="@font/inter_medium"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/discountLabel"
                app:layout_constraintBottom_toBottomOf="@id/discountLabel" />
            <TextView
                android:id="@+id/taxLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tax (10%)"
                android:textColor="#5C625E"
                android:fontFamily="@font/inter_medium"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/discountLabel" />

            <TextView
                android:id="@+id/taxValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs 80"
                android:textColor="#5C625E"
                android:fontFamily="@font/inter_medium"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/taxLabel"
                app:layout_constraintBottom_toBottomOf="@id/taxLabel" />

            <View
                android:id="@+id/summaryDivider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#E8E5DF"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/taxLabel" />

            <TextView
                android:id="@+id/totalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total"
                android:textColor="@color/btn_bg_dark"
                android:fontFamily="@font/inter_bold"
                android:textSize="15sp"
                android:layout_marginTop="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/summaryDivider" />

            <TextView
                android:id="@+id/totalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs 880"
                android:textColor="@color/btn_bg_dark"
                android:fontFamily="@font/inter_bold"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/totalLabel"
                app:layout_constraintBottom_toBottomOf="@id/totalLabel" />

        </androidx.constraintlayout.widget.ConstraintLayout>








    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dateRangeSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:background="@drawable/bg_review_invoice_box"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/billingDetailsBox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textColor="#9CA3A0"
            android:textSize="12sp"
            android:fontFamily="@font/inter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
        <TextView
            android:id="@+id/dateRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20 sept 2026 -> 20 oct 2026"
            android:textColor="@color/btn_bg_dark"
            android:textSize="12sp"
            android:fontFamily="@font/inter_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>