<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="12dp"
    android:paddingHorizontal="16dp"
    android:background="@color/bg_cream">

    <TextView
        android:id="@+id/itemsHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What are they buying?"
        android:textColor="@color/btn_bg_dark"
        android:textSize="20sp"
        android:fontFamily="@font/inter_bold"
        android:letterSpacing="0.015"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/selectItemsSubheading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/subheading_color_home"
        android:fontFamily="@font/inter"
        android:text="Scan a barcode or tap to add , adjust quantities below"
        app:layout_constraintTop_toBottomOf="@id/itemsHeading"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/scanBarcodeBtn"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="14dp"
        android:text="Scan barcode"
        android:textSize="12.5sp"
        android:textAllCaps="false"
        android:textColor="#171817"
        android:fontFamily="@font/inter_semibold"
        android:letterSpacing="0"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_scan"
        app:iconTint="#0C861A"
        app:iconGravity="textStart"
        app:iconPadding="7dp"
        app:iconSize="15dp"
        app:strokeColor="#E8E5DF"
        app:strokeWidth="1dp"
        app:cornerRadius="999dp"
        app:backgroundTint="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/selectItemsSubheading"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/scanBarcodeBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/bg_select_items_new_invoice"
        android:padding="12dp"
        >
        <TextView
            android:id="@+id/catalogueHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CATALOGUE"
            android:textSize="10sp"
            android:textColor="#9CA3A0"
            android:fontFamily="@font/inter_semibold"
            android:letterSpacing="0.08"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/searchCatalogueSection"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/catalogueHeading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/search_invoice_bg"
            >
            <ImageView
                android:id="@+id/searchIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/ic_search"
                android:layout_marginStart="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />
            <EditText
                android:id="@+id/searchField"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="Search Catalogue"
                android:layout_marginStart="14dp"
                app:layout_constraintStart_toEndOf="@id/searchIcon"
                android:background="@null"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="32dp"
                android:textSize="13sp"
                android:textColor="@color/btn_bg_dark"
                android:fontFamily="@font/inter_medium"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
      <com.google.android.material.chip.ChipGroup
          android:id="@+id/catalogueChipGroup"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toBottomOf="@id/searchCatalogueSection"
          app:singleSelection="false"
          app:chipSpacingHorizontal="6dp"
          app:chipSpacingVertical="0dp"
          />





    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>