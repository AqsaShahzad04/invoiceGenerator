<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FBFAF7">

    <!-- Top Bar -->
    <ImageView
        android:id="@+id/backbtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_back"
        android:scaleType="center"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/ItemsHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New item"
        android:textSize="18sp"
        android:textColor="#171817"
        android:fontFamily="@font/inter_bold"
        android:letterSpacing="-0.015"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toTopOf="@id/backbtn"
        app:layout_constraintBottom_toBottomOf="@id/backbtn"
        app:layout_constraintStart_toEndOf="@id/backbtn" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/backbtn"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/itemNameheading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Item name"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:textColor="#5C625E"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                android:fontFamily="@font/inter_medium" />

            <EditText
                android:id="@+id/itemNameInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="Basmati Rice"
                android:inputType="text"
                android:textSize="13sp"
                android:textColor="#171817"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/itemNameheading"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/barcodeHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Barcode"
                android:textSize="11sp"
                android:textColor="#5C625E"
                android:letterSpacing="0.02"
                android:fontFamily="@font/inter_medium"
                app:layout_constraintTop_toBottomOf="@id/itemNameInput"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/barcodeinputField"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_input_field"
                android:hint="Optional — scan or leave blank"
                android:drawableStart="@drawable/ic_barcode"
                android:drawablePadding="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="13sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#171817"
                android:singleLine="true"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barcodeHeading"
                app:layout_constraintEnd_toStartOf="@id/scanbtn"
                app:layout_constraintBottom_toBottomOf="@id/scanbtn"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="6dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/scanbtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/scan_btn_bg"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                app:layout_constraintTop_toBottomOf="@id/barcodeHeading"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="6dp">

                <ImageView
                    android:id="@+id/scanIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_scan"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/primary_green"
                    android:layout_marginStart="6dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/scanIcon" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/barcodeSuggestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Maps this number to the product. Leave blank to add manually."
                android:textSize="11sp"
                android:textColor="#9CA3A0"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/scanbtn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ===== PRICE ===== -->

            <TextView
                android:id="@+id/priceHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Price"
                android:textSize="11sp"
                android:textColor="#5C625E"
                android:letterSpacing="0.02"
                android:fontFamily="@font/inter_medium"
                app:layout_constraintTop_toBottomOf="@id/barcodeSuggestion"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/priceInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:text="0"
                android:inputType="numberDecimal"
                android:textSize="17sp"
                android:textColor="#171817"
                android:fontFamily="@font/inter_semibold"
                android:paddingStart="36dp"
                android:paddingEnd="14dp"
                android:paddingVertical="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/priceHeading"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/dollarSign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$"
                android:textSize="13sp"
                android:textColor="#9CA3A0"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/inter_medium"
                app:layout_constraintStart_toStartOf="@id/priceInput"
                app:layout_constraintTop_toTopOf="@id/priceInput"
                app:layout_constraintBottom_toBottomOf="@id/priceInput" />

            <!-- ===== UNIT ===== -->

            <TextView
                android:id="@+id/unitHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Unit"
                android:textSize="11sp"
                android:textColor="#5C625E"
                android:letterSpacing="0.02"
                android:fontFamily="@font/inter_medium"
                app:layout_constraintTop_toBottomOf="@id/priceInput"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/unitChipGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:layout_constraintTop_toBottomOf="@id/unitHeading"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.App.Chip"
                    android:id="@+id/chipPiece"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="piece"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.App.Chip"
                    android:id="@+id/chipKg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kg" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.App.Chip"
                    android:id="@+id/chipBag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="bag" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.App.Chip"
                    android:id="@+id/chipTin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="tin" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.App.Chip"
                    android:id="@+id/chipPack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="pack" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.App.Chip"
                    android:id="@+id/chipBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="box" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.App.Chip"
                    android:id="@+id/chipFlat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="flat" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.App.Chip"
                    android:id="@+id/chipHour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="hour" />

            </com.google.android.material.chip.ChipGroup>

            <!-- ===== CATEGORY ===== -->

            <TextView
                android:id="@+id/categoryHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Category"
                android:textSize="11sp"
                android:textColor="#5C625E"
                android:letterSpacing="0.02"
                android:fontFamily="@font/inter_medium"
                app:layout_constraintTop_toBottomOf="@id/unitChipGroup"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/categoryChipGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:layout_constraintTop_toBottomOf="@id/categoryHeading"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.App.Chip"
                    android:id="@+id/chipGrocery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grocery"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.App.Chip"
                    android:id="@+id/chipHousehold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Household" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.App.Chip"
                    android:id="@+id/chipElectronics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Electronics" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.App.Chip"
                    android:id="@+id/chipService"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.App.Chip"
                    android:id="@+id/chipOther"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Other" />

            </com.google.android.material.chip.ChipGroup>

            <!-- ===== CREATE BUTTON ===== -->
            <TextView
                android:id="@+id/createItemBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_create_item_btn"
                android:text="Create item"
                android:textAllCaps="false"
                android:textColor="#FBFAF7"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:paddingVertical="14dp"
                app:layout_constraintTop_toBottomOf="@id/categoryChipGroup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
