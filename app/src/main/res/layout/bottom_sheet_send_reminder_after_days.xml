<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_currency_picker_sheet"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="28dp">

    <view class="android.widget.ImageView"
        android:id="@+id/dragHandleReminder"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/drag_handle_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:id="@+id/reminderTitleGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/dragHandleReminder"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/closebtn"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/reminderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send reminder after"
            android:fontFamily="@font/inter_bold"
            android:textSize="17sp"
            android:letterSpacing="-0.015"
            android:textColor="@color/btn_text_dark"/>

        <TextView
            android:id="@+id/reminderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="Days past the due date before the first automatic email goes out."
            android:layout_marginTop="4dp"
            android:textColor="@color/subheading_color_home"
            android:lineSpacingMultiplier="1.5"/>

    </LinearLayout>

    <ImageButton
        android:id="@+id/closebtn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_cross_button"
        android:backgroundTint="#F4F2EE"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/reminderTitle"
        app:layout_constraintBottom_toBottomOf="@id/reminderTitle"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/reminderDisplayBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_invoice_prefix_display"
        android:padding="22dp"
        app:layout_constraintTop_toBottomOf="@id/reminderTitleGroup"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/reminderStepperRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/decreaseReminderDaysBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_stepper_circle_btn"
                android:text="−"
                android:clickable="true"
                android:gravity="center"
                android:fontFamily="@font/inter_semibold"
                android:textSize="20sp"
                android:textColor="@color/btn_text_dark"
                android:layout_marginEnd="14dp"/>

            <TextView
                android:id="@+id/reminderDaysValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="3"
                android:gravity="center"
                android:fontFamily="@font/inter_bold"
                android:textSize="36sp"
                android:letterSpacing="-0.025"
                android:textColor="@color/primary_green"/>

            <TextView
                android:id="@+id/increaseReminderDaysBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_stepper_circle_btn"
                android:text="+"
                android:clickable="true"
                android:gravity="center"
                android:fontFamily="@font/inter_semibold"
                android:textSize="20sp"
                android:textColor="@color/btn_text_dark"
                android:layout_marginStart="14dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/reminderDaysLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="days past due"
            android:textSize="11sp"
            android:textColor="@color/subheading_color_home"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/reminderStepperRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/reminderPresetsChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/reminderDisplayBox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:singleSelection="true"
        app:selectionRequired="false"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="6dp"/>

    <Button
        android:id="@+id/doneBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Done"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/bg_cream"
        app:backgroundTint="@null"
        android:background="@drawable/green_btn_bg"
        android:backgroundTint="@color/btn_bg_dark"
        app:layout_constraintTop_toBottomOf="@id/reminderPresetsChipGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>