<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/CurrencySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:paddingHorizontal="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/currencyCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="code"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_semibold"
                    />
                <TextView
                    android:id="@+id/currencyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name of the currency"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/subheading_color_home"
                    />
            </LinearLayout>
            <RadioButton
                android:id="@+id/currencyRadioBtn"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:checked="false"
                android:button="@null"
                android:background="@drawable/selector_currency_state"
                />

        </LinearLayout>

        <view class="android.widget.ImageView"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#0F171817"
            />


    </LinearLayout>

</LinearLayout>