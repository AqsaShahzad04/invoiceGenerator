<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: glow (bada, faded) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#000C861A"
                android:centerColor="#800C861A"
                android:endColor="#000C861A" />
        </shape>
    </item>

    <!-- Layer 2: asli solid line (chhoti, center mein) -->
    <item
        android:top="5dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#0C861A" />
        </shape>
    </item>

</layer-list>